<UserControl x:Class="Assign_2.ChartTile2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="10" 
            Margin="0,12,12,0" 
            Padding="20,16" 
            Background="#1E1E22">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thermometer Bar Graph Visual -->
            <Viewbox Grid.Column="0" Width="60" Height="130" Margin="10,0,20,0">
                <Canvas Width="60" Height="140">
                    <!-- Outer Glass Background -->
                    <Rectangle Canvas.Left="20" Width="20" Height="110" Fill="#2A2A30" RadiusX="10" RadiusY="10"/>
                    <Ellipse Canvas.Left="8" Canvas.Top="90" Width="44" Height="44" Fill="#2A2A30"/>

                    <!-- Liquid Bulb (Bottom) -->
                    <Ellipse x:Name="BulbLiquid" Canvas.Left="14" Canvas.Top="96" Width="32" Height="32" Fill="IndianRed"/>

                    <!-- Liquid Column -->
                    <Canvas Canvas.Left="26" Canvas.Top="8" Width="8" Height="104" ClipToBounds="True">
                        <Rectangle x:Name="TempBar" Width="8" Height="0" Canvas.Top="104" Fill="IndianRed" RadiusX="4" RadiusY="4"/>
                    </Canvas>
                </Canvas>
            </Viewbox>

            <!-- Text Display -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center">
                <TextBlock x:Name="CurrentValueText" Text="--" Foreground="White" FontSize="48" FontWeight="Light"/>
                <TextBlock Text="°C" Foreground="#A0A0A5" FontSize="20" VerticalAlignment="Top" Margin="4,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>