<UserControl x:Class="Assign_2.ChartTile2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="400">
    <Border x:Name="RootBorder" CornerRadius="10" Margin="4" Padding="12"
        Background="Blue">
        <Grid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="200,4,0,4" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentValueText" Text="--" Foreground="White"
               FontSize="80" FontWeight="Light"/>
                <TextBlock Text="°C" Foreground="#B0B0B5" FontSize="50"
               VerticalAlignment="Top" Margin="2,4,0,0"/>
            </StackPanel>
            <Canvas Width="14" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top">
                <!--PEAK THERMOMETRE DESIGN LOWKEY-->

                <Ellipse Canvas.Left="51" Canvas.Top="230" Width="108" Height="108" Fill="MintCream" HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <Rectangle Canvas.Left="85" Canvas.Top="26" Width="40" Height="244" Fill="MintCream" RadiusX="20" RadiusY="20" HorizontalAlignment="Left" VerticalAlignment="Top" />

                <Rectangle Canvas.Left="98" Canvas.Top="36" Width="14" Height="228" Fill="Red" RadiusX="10" RadiusY="10" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Top" />

                <Ellipse Canvas.Left="70" Canvas.Top="249" Width="70" Height="70" Fill="Red" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Top"/>

            </Canvas>

        </Grid>
    </Border>
    </UserControl>
