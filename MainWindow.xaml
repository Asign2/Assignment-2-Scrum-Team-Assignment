<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        mc:Ignorable="av" 
        x:Class="Assign_2.MainWindow"
        Title="MainWindow" Height="450" Width="800"
        WindowState="Maximized">

    <Window.Resources>
        <!-- CENTRALIZED XAML SIZING STYLES -->
        <!-- Uniform height and spacing for all dashboard graph controls -->
        <Style TargetType="{x:Type UserControl}" x:Key="DashboardGraphStyle">
            <Setter Property="Height" Value="160"/>
            <Setter Property="Margin" Value="3,4,3,4"/>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- LOGIN VIEW -->
        <StackPanel x:Name="LoginScreen" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Login" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=UsernameBox}">
                <AccessText Text="_Username"/>
            </Label>
            <TextBox x:Name="UsernameBox" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=PasswordBox}">
                <AccessText Text="_Password"/>
            </Label>
            <PasswordBox x:Name="PasswordBox" Height="25" Margin="0,0,0,15"/>
            <Button Content="Sign In" Height="30" Click="LoginButton_Click" IsDefault="True"/>
        </StackPanel>

        <!-- ADMIN VIEW -->
        <Grid x:Name="AdminScreen" Visibility="Collapsed" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0">
                <!-- USERS TAB -->
                <TabItem Header="Users">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="UsersGrid" Grid.Row="0" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="UsersGrid_SelectionChanged" IsReadOnly="True" Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50" />
                                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="155" />
                                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150" />
                                <DataGridTextColumn Header="First Name" Binding="{Binding first_name}" Width="120" />
                                <DataGridTextColumn Header="Last Name" Binding="{Binding last_name}" Width="120" />
                                <DataGridTextColumn Header="Date Created" Binding="{Binding date_created, StringFormat=dd MMM yyyy}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Vertical">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Label Width="110" VerticalAlignment="Center" Target="{Binding ElementName=Id}">
                                        <AccessText Text="_Id"/>
                                    </Label>
                                    <TextBox x:Name="ShowIDBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Label Width="110" VerticalAlignment="Center" Target="{Binding ElementName=EditUsernameBox}">
                                        <AccessText Text="_Username:"/>
                                    </Label>
                                    <TextBox x:Name="EditUsernameBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Label Width="110" VerticalAlignment="Center" Target="{Binding ElementName=first_name}">
                                        <AccessText Text="_First Name:"/>
                                    </Label>
                                    <TextBox x:Name="EditFirstNameBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Label Width="110" VerticalAlignment="Center" Target="{Binding ElementName=last_name}">
                                        <AccessText Text="_Last Name:"/>
                                    </Label>
                                    <TextBox x:Name="EditLastNameBox" Width="180"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Label Width="110" VerticalAlignment="Center" Target="{Binding ElementName=RoleBox}">
                                        <AccessText Text="_Role:"/>
                                    </Label>
                                    <ComboBox x:Name="RoleBox" Width="180">
                                        <ComboBoxItem Content="Admin" />
                                        <ComboBoxItem Content="User" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Label Width="110" VerticalAlignment="Center" Target="{Binding ElementName=NewPasswordBox}">
                                        <AccessText Text="New _Password:"/>
                                    </Label>
                                    <PasswordBox x:Name="NewPasswordBox" Width="180" Margin="0,0,10,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                <Button Content="Update Details" Click="SaveChanges_Click" Width="110" Height="28" Margin="0,0,10,0" />
                                <Button Content="Delete User" Click="DeleteUser_Click" Width="110" Height="28" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- SENSOR / DASHBOARD SETTINGS TAB -->
                <TabItem Header="Sensor Settings">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Dashboard Configuration" FontWeight="Bold" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Label Width="110" VerticalAlignment="Center" Target="{Binding ElementName=DefaultGranularityBox}">
                                        <AccessText Text="Default _Interval:"/>
                                    </Label>
                                    <ComboBox x:Name="DefaultGranularityBox" Width="100">
                                        <ComboBoxItem Content="Daily"/>
                                        <ComboBoxItem Content="Weekly"/>
                                        <ComboBoxItem Content="Monthly"/>
                                        <ComboBoxItem Content="Yearly"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save Settings" Width="120" Click="SaveSettings_Click" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="SettingsUpdatedText" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                    <Button Content="Add new Sensor" Width="120" Click="NewSensor_Click" Margin="0,0,10,0"></Button>
                                    <Button Content="Update Sensor" Width="120" Click="UpdateSensor_Click" Margin="0,0,10,0"></Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataGrid x:Name="SensorsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                                <DataGridTextColumn Header="Make" Binding="{Binding Make}" Width="120"/>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="120"/>
                                <DataGridTextColumn Header="Floor" Binding="{Binding Floor}" Width="120"/>
                                <DataGridTextColumn Header="Room" Binding="{Binding Room}" Width="120"/>
                                <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="80"/>
                                <DataGridTemplateColumn Header="Activate/Deactivate" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Toggle" Click="ToggleSensor_Click" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="420,0,0,50">
                            <TextBlock Text="Active Graphs:" Width="110" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <CheckBox x:Name="BarCheckbox" Content="Current temp" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="BoxplotCheckbox" Content="Temp Comparison" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="LineChcekbox" Content="Temp Reading" IsChecked="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <!-- DASHBOARD LOG TAB -->
                <TabItem Header="Dashboard Log">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="Refresh Log" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10" Click="RefreshLog_Click"/>
                        <DataGrid x:Name="LogGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Viewed At" Binding="{Binding ViewedAt}" Width="140"/>
                                <DataGridTextColumn Header="Viewed By" Binding="{Binding ViewedBy}" Width="120"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="150"/>
                                <DataGridTextColumn Header="Interval" Binding="{Binding Granularity}" Width="80"/>
                                <DataGridTextColumn Header="Avg °C" Binding="{Binding AvgTemp}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Add New User" Width="110" Margin="0,0,10,0" Click="ShowNewUserScreen_Click"/>
                <Button Content="Logout" Width="100" Margin="0,0,10,0" Click="LogoutButton_Click"/>
                <Button Content="Export UserLog" Width="100" Margin="0,0,10,0" Click="ExportUserLog"/>
                <Button Content="Export Full Data" Margin="0,0,10,0" Click="ExportAllDataJson_Click"/>
            </StackPanel>
        </Grid>
        <!-- New Sensor View-->
        <StackPanel x:Name="NewSensorScreen" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Create Sensor Below" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewMake}">
                <AccessText Text="New _Make"/>
            </Label>
            <TextBox x:Name="NewMake" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewModel}">
                <AccessText Text="New _Model"/>
            </Label>
            <TextBox x:Name="NewModel" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewFloor}">
                <AccessText Text="New _Floor"/>
            </Label>
            <TextBox x:Name="NewFloor" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewRoom}">
                <AccessText Text="New _Room"/>
            </Label>
            <TextBox x:Name="NewRoom" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=Newvariance}">
                <AccessText Text="New _Variance"/>
            </Label>
            <TextBox x:Name="Newvariance" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewBool}">
                <AccessText Text="Actived/Deactivate"/>
            </Label>
            <ComboBox x:Name="NewBool" Height="25" Margin="0,0,0,10" IsEditable="True" IsReadOnly="True" Text="Select If Active or not" StaysOpenOnEdit="True">
                <ComboBoxItem Content="True"/>
                <ComboBoxItem Content="False"/>
            </ComboBox>
            <Button Content="Register New Sensor" Width="auto" Height="30" Click="RegisterSensor_Click"/>
            <Button Content="Return" Width="auto" Height="30" Click="ReturnButton_Click"/>
        </StackPanel>
        <!-- Update Sensors View -->
        <StackPanel x:Name="UpdateSensorScreen" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
    <TextBlock Text="Update Sensor Below" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
    
    <Label HorizontalAlignment="Left" Target="{Binding ElementName=SensorIDComboBox}">
        <AccessText Text="Select _Sensor ID"/>
    </Label>
            <ComboBox x:Name="SensorIDComboBox" Height="25" Margin="0,0,0,10" 
          DisplayMemberPath="Id" 
          SelectedValuePath="Id"
          SelectionChanged="SensorIDComboBox_SelectionChanged"/>

            <Label HorizontalAlignment="Left" Target="{Binding ElementName=UpdateMake}">
        <AccessText Text="Update _Make"/>
    </Label>
    <TextBox x:Name="UpdateMake" Height="25" Margin="0,0,0,10"/>

    <Label HorizontalAlignment="Left" Target="{Binding ElementName=UpdateModel}">
        <AccessText Text="Update _Model"/>
    </Label>
            <TextBox x:Name="UpdateModel" Height="25" Margin="0,0,0,10" />

    <Label HorizontalAlignment="Left" Target="{Binding ElementName=UpdateFloor}">
        <AccessText Text="_Floor" />
    </Label>
            <TextBox x:Name="UpdateFloor" Height="25" Margin="0,0,0,10" IsReadOnly="True"/>

    <Label HorizontalAlignment="Left" Target="{Binding ElementName=UpdateRoom}">
        <AccessText Text="_Room"/>
    </Label>
            <TextBox x:Name="UpdateRoom" Height="25" Margin="0,0,0,10" IsReadOnly="True"/>

    <Button Content="Update Sensor Details" Width="auto" Height="30" Margin="0,10,0,5" Click="RegisterSensorUpdate_Click"/>
    <Button Content="Return" Width="auto" Height="30" Click="ReturnButton_Click"/>
</StackPanel>
        <!-- NEW USER VIEW -->
        <StackPanel x:Name="NewUserScreen" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Create User Below" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewUsername}">
                <AccessText Text="New _Username"/>
            </Label>
            <TextBox x:Name="NewUsername" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewPassword}">
                <AccessText Text="New _Password"/>
            </Label>
            <PasswordBox x:Name="NewPassword" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewFirstname}">
                <AccessText Text="New _FirstNme"/>
            </Label>
            <TextBox x:Name="NewFirstname" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewLastname}">
                <AccessText Text="New _LastName"/>
            </Label>
            <TextBox x:Name="NewLastname" Height="25" Margin="0,0,0,10"/>
            <Label HorizontalAlignment="Left" Target="{Binding ElementName=NewRole}">
                <AccessText Text="New _Role"/>
            </Label>
            <ComboBox x:Name="NewRole" Height="25" Margin="0,0,0,10" IsEditable="True" IsReadOnly="True" Text="Select a role..." StaysOpenOnEdit="True">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="User"/>
            </ComboBox>
            <Button Content="Register New User" Width="auto" Height="30" Click="RegisterButton_Click"/>
            <Button Content="Return" Width="auto" Height="30" Click="ReturnButton_Click"/>
        </StackPanel>

        <!-- USER VIEW -->
        <StackPanel x:Name="UserScreen" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="Temperature Dashboard" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Label VerticalAlignment="Center" Target="{Binding ElementName=LocationFilterBox}">
                    <AccessText Text="_Location:"/>
                </Label>

                <!--Tree View multi select combo box-->
                <ToggleButton x:Name="LocationToggleButton" Width="110" Height="25" Content="Select Locations"/>
                <Popup PlacementTarget="{Binding ElementName=LocationToggleButton}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=LocationToggleButton}" StaysOpen="False">
                    <Border BorderBrush="Gray" BorderThickness="1" Background="White">
                        <ScrollViewer Height="200" Width="200">
                            <TreeView x:Name="LocationTreeView" SelectedItemChanged="LocationTreeView_SelectedItemChanged"/>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <Label VerticalAlignment="Center" Target="{Binding ElementName=UserGranularityBox}">
                    <AccessText Text="_Interval:"/>
                </Label>
                <ComboBox x:Name="UserGranularityBox" Width="110" SelectionChanged="ReadingFilter_Changed">
                    <ComboBoxItem Content="Daily"/>
                    <ComboBoxItem Content="Weekly"/>
                    <ComboBoxItem Content="Monthly"/>
                    <ComboBoxItem Content="Yearly"/>
                </ComboBox>
            </StackPanel>

            <!-- Auto Width Adjusting CONTAINER CONTROLLED VIA XAML -->
            <Border BorderBrush="#DDDDDD" Height="875" Width="Auto" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="ChartHost" Margin="10">
                        <Grid.Resources>
                            <!-- Applies the sizing style to every graph control automatically -->
                            <Style TargetType="UserControl" BasedOn="{StaticResource DashboardGraphStyle}"/>
                        </Grid.Resources>
                    </Grid>
                </ScrollViewer>
            </Border>

            <WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Export simplified Data" Padding="10,4" Height="28" Margin="0,0,10,5" Click="ExportTemperatureData_Click"/>
                <Button Content="Export Full Data" Padding="10,4" Height="28" Margin="0,0,10,5" Click="ExportAllDataJson_Click"/>
                <Button Content="Logout" Padding="15,4" Height="28" Margin="0,0,0,5" Click="LogoutButton_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- CHART OVERLAY -->
 
        <Grid x:Name="ChartOverlay" Visibility="Collapsed" Background="#AA000000">
            <Border Background="White" CornerRadius="6" Padding="10" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1250" Height="700">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button Content="X" Width="28" Height="20" DockPanel.Dock="Right" Margin="0,20,0,0" Click="CloseChartOverlay_Click"/>
                        <TextBlock x:Name="OverlayTitleText" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </DockPanel>
                    <Grid Grid.Row="1" x:Name="OverlayContentHost" Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>