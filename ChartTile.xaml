<UserControl x:Class="Assign_2.ChartTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="160">
    <Border x:Name="RootBorder" CornerRadius="10" Margin="4" Padding="12"
            Background="#1C1C1E" Cursor="Hand" MouseLeftButtonUp="EnlargeChart">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TITLE + THERMOMETER ICON -->
            <Grid Grid.Row="0">
                <TextBlock x:Name="TitleText" Text="Chart" Foreground="#B0B0B5"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Canvas Width="14" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Line Canvas.Left="6" Canvas.Top="2" Width="2" Height="15" Stroke="White"/>
                    <Rectangle Canvas.Left="5" Canvas.Top="0" Width="4" Height="12"
                               Fill="#4A90D9" RadiusX="2" RadiusY="2"/>
                    <Ellipse Canvas.Left="2" Canvas.Top="10" Width="10" Height="10" Fill="#4A90D9"/>
                </Canvas>
            </Grid>

            <!-- CURRENT VALUE -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,4" VerticalAlignment="Bottom">
                <TextBlock x:Name="CurrentValueText" Text="--" Foreground="White"
                           FontSize="30" FontWeight="Light"/>
                <TextBlock Text="°C" Foreground="#B0B0B5" FontSize="14"
                           VerticalAlignment="Top" Margin="2,4,0,0"/>
            </StackPanel>

            <!-- SPARKLINE + HOVER -->
            <Grid Grid.Row="2" x:Name="SparklineHost" ClipToBounds="False" Background="Transparent"
                  MouseMove="SparklineHost_MouseMove" MouseLeave="SparklineHost_MouseLeave">

                <Polyline x:Name="Sparkline" Stroke="#5FD68A" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                <Canvas x:Name="HoverCanvas" IsHitTestVisible="False">
                    <Ellipse x:Name="HoverPoint" Width="8" Height="8" Fill="#5FD68A"
                             Stroke="White" StrokeThickness="1" Visibility="Collapsed"/>

                    <Border x:Name="TemperatureTooltip" Background="#252529" BorderBrush="#444448"
                            BorderThickness="1" CornerRadius="6" Padding="8,5" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="TooltipTemperature" Text="-- °C" Foreground="White"
                                       FontSize="12" FontWeight="SemiBold"/>

                            <StackPanel x:Name="TooltipRangePanel" Orientation="Horizontal"
                                        Margin="0,2,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TooltipMinTemp" Text="Min: --" Foreground="#88888D" FontSize="10"/>
                                <TextBlock Text="  •  " Foreground="#88888D" FontSize="10"/>
                                <TextBlock x:Name="TooltipMaxTemp" Text="Max: --" Foreground="#88888D" FontSize="10"/>
                            </StackPanel>

                            <TextBlock x:Name="TooltipTime" Text="" Foreground="#A0A0A5"
                                       FontSize="9.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </Grid>

            <!-- MIN / AVG / MAX FOOTER -->
            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Min" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="MinValueText" Text="--" Foreground="#D0D0D5" FontSize="10"/>
                    <TextBlock x:Name="MinTimeText" Text="" Foreground="#808085" FontSize="9"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Avg" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AvgValueText" Text="--" Foreground="#D0D0D5" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <TextBlock Text="Max" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="MaxValueText" Text="--" Foreground="#D0D0D5" FontSize="10" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="MaxTimeText" Text="" Foreground="#808085" FontSize="9" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="NoDataText" Grid.Row="0" Grid.RowSpan="4" Text="No data"
                       Foreground="Gray" FontSize="10"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</UserControl>