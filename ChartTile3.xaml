<UserControl x:Class="Assign_2.DotPlot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="220">
    <Border CornerRadius="10" Margin="4" Padding="12" Background="#1C1C1E">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER: title, subtitle, legend -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" Text="Temperature" Foreground="White"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="" Foreground="#808085" FontSize="10"/>
                </StackPanel>
            </Grid>

            <!-- PLOT -->
            <Border Grid.Row="1" Background="#151517" CornerRadius="6" Padding="4">
                <Grid>
                    <Grid>
                        <Image x:Name="PlotImage" Stretch="Fill"/>
                        <Canvas x:Name="LabelLayer"/>
                    </Grid>
                    <TextBlock x:Name="NoDataText" Text="No data" Foreground="Gray" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- FOOTER: points / min / avg / max -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Points" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="PointsText" Text="--" Foreground="#D0D0D5" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Min" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MinText" Text="--" Foreground="#D0D0D5" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="MinPeriodText" Text="" Foreground="#808085" FontSize="9" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Avg" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AvgText" Text="--" Foreground="#D0D0D5" FontSize="11" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                    <TextBlock Text="Max" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="MaxText" Text="--" Foreground="#D0D0D5" FontSize="11" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="MaxPeriodText" Text="" Foreground="#808085" FontSize="9" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>